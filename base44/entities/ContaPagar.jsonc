{
  "name": "ContaPagar",
  "type": "object",
  "properties": {
    "unidade_id": {
      "type": "string",
      "description": "ID da unidade a que esta conta pertence"
    },
    "fornecedor": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "aluguel",
        "energia",
        "agua",
        "internet",
        "telefone",
        "folha_pagamento",
        "impostos",
        "contador",
        "sistema",
        "seguros",
        "manutencao",
        "fornecedor_pecas",
        "marketing",
        "financeiro",
        "outros"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "blue",
        "purple",
        "purple",
        "red",
        "red",
        "gray",
        "gray",
        "gray",
        "yellow",
        "green",
        "pink",
        "green",
        "gray"
      ]
    },
    "descricao": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date-time"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date-time"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "cartao_credito",
        "cartao_debito",
        "transferencia",
        "boleto"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "vencido",
        "cancelado"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "default": "pendente"
    },
    "compra_id": {
      "type": "string"
    },
    "conta_prevista_id": {
      "type": "string",
      "description": "ID da conta prevista (planejamento) que gerou esta conta do m\u00eas"
    },
    "competencia": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia da conta no formato AAAA-MM (usado para n\u00e3o duplicar a gera\u00e7\u00e3o mensal)"
    },
    "usuario_lancamento": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "descricao",
    "valor",
    "data_vencimento"
  ]
}