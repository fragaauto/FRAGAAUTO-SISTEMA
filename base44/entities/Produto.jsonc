{
  "name": "Produto",
  "type": "object",
  "properties": {
    "unidade_id": {
      "type": "string",
      "description": "ID da unidade a que este produto pertence"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do produto"
    },
    "nome": {
      "type": "string",
      "description": "Nome do produto ou servi\u00e7o"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria do produto (texto livre \u2014 pode ser criada livremente)"
    },
    "unidade": {
      "type": "string",
      "enum": [
        "unidade",
        "par",
        "jogo",
        "kit"
      ],
      "default": "unidade",
      "description": "Unidade de medida do produto"
    },
    "valor": {
      "type": "number",
      "description": "Valor unit\u00e1rio de venda (equivale ao m\u00ednimo da faixa quando usar_faixa_preco for true)"
    },
    "usar_faixa_preco": {
      "type": "boolean",
      "default": false,
      "description": "Se true, o servi\u00e7o utiliza faixa de pre\u00e7o (valor_minimo at\u00e9 valor_maximo) em vez de valor fixo"
    },
    "valor_minimo": {
      "type": "number",
      "description": "Valor m\u00ednimo da faixa de pre\u00e7o (servi\u00e7os com valor vari\u00e1vel conforme dificuldade)"
    },
    "valor_maximo": {
      "type": "number",
      "description": "Valor m\u00e1ximo da faixa de pre\u00e7o (servi\u00e7os com valor vari\u00e1vel conforme dificuldade)"
    },
    "custo": {
      "type": "number",
      "description": "Custo unit\u00e1rio (custo m\u00e9dio)"
    },
    "descricao": {
      "type": "string"
    },
    "vantagens": {
      "type": "string"
    },
    "desvantagens": {
      "type": "string"
    },
    "aplicacao_universal": {
      "type": "boolean",
      "default": false
    },
    "modelos_compativeis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fotos": {
      "type": "array",
      "description": "Fotos do produto",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL p\u00fablica da foto"
          },
          "descricao": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o ou legenda da foto"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          }
        }
      }
    },
    "variacoes": {
      "type": "array",
      "description": "Varia\u00e7\u00f5es deste produto (ex: modelos diferentes, tamanhos, vers\u00f5es). Cada varia\u00e7\u00e3o pode ter pre\u00e7o, composi\u00e7\u00e3o e fotos pr\u00f3prios.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID \u00fanico da varia\u00e7\u00e3o"
          },
          "nome": {
            "type": "string",
            "description": "Nome da varia\u00e7\u00e3o (ex: Para 2 portas, Para 4 portas)"
          },
          "descricao": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o da varia\u00e7\u00e3o \u2014 ser\u00e1 puxada para observa\u00e7\u00f5es do item ao incluir no atendimento"
          },
          "valor": {
            "type": "number",
            "description": "Valor da varia\u00e7\u00e3o (equivale ao m\u00ednimo da faixa quando usar_faixa_preco for true)"
          },
          "usar_faixa_preco": {
            "type": "boolean",
            "default": false
          },
          "valor_minimo": {
            "type": "number"
          },
          "valor_maximo": {
            "type": "number"
          },
          "composicao": {
            "type": "array",
            "description": "Composi\u00e7\u00e3o espec\u00edfica desta varia\u00e7\u00e3o (sobrescreve a composi\u00e7\u00e3o do produto pai)",
            "items": {
              "type": "object",
              "properties": {
                "produto_id": {
                  "type": "string"
                },
                "produto_nome": {
                  "type": "string"
                },
                "codigo": {
                  "type": "string"
                },
                "quantidade": {
                  "type": "number",
                  "default": 1
                }
              }
            }
          },
          "fotos": {
            "type": "array",
            "description": "Fotos demonstrando a instala\u00e7\u00e3o desta varia\u00e7\u00e3o",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "descricao": {
                  "type": "string"
                },
                "data_upload": {
                  "type": "string",
                  "format": "date-time"
                },
                "usuario": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "nome"
        ]
      },
      "default": []
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "controla_estoque": {
      "type": "boolean",
      "default": false
    },
    "estoque_atual": {
      "type": "number",
      "default": 0
    },
    "estoque_minimo": {
      "type": "number",
      "default": 0
    },
    "estoque_desejado": {
      "type": "number",
      "default": 0
    },
    "localizacao_estoque": {
      "type": "string"
    },
    "composicao": {
      "type": "array",
      "description": "Lista de componentes que comp\u00f5em este produto (kit/pacote). Quando o produto \u00e9 composto, a baixa de estoque ao vend\u00ea-lo \u00e9 feita nos componentes, multiplicada pela quantidade vendida.",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string",
            "description": "ID do produto componente"
          },
          "produto_nome": {
            "type": "string",
            "description": "Nome do componente (cache)"
          },
          "codigo": {
            "type": "string",
            "description": "C\u00f3digo do componente (cache)"
          },
          "quantidade": {
            "type": "number",
            "default": 1,
            "description": "Quantidade do componente por unidade do produto composto"
          }
        }
      }
    },
    "fornecedores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fornecedor_id": {
            "type": "string"
          },
          "fornecedor_nome": {
            "type": "string"
          },
          "codigo_fornecedor": {
            "type": "string"
          },
          "preco_compra": {
            "type": "number"
          },
          "principal": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "required": [
    "codigo",
    "nome",
    "categoria",
    "valor"
  ]
}