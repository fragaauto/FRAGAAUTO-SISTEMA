{
  "name": "Promocao",
  "type": "object",
  "properties": {
    "unidade_id": {
      "type": "string",
      "description": "ID da unidade a que esta promo\u00e7\u00e3o pertence"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da campanha promocional"
    },
    "texto": {
      "type": "string",
      "description": "Texto da promo\u00e7\u00e3o enviado no WhatsApp e exibido na p\u00e1gina p\u00fablica. Aceita {nome} para o nome do cliente."
    },
    "banner_url": {
      "type": "string",
      "description": "Banner de topo da p\u00e1gina p\u00fablica (propor\u00e7\u00e3o recomendada 8:3, ex: 1600x600 px)"
    },
    "artes": {
      "type": "array",
      "description": "Artes promocionais exibidas ao longo da p\u00e1gina p\u00fablica (propor\u00e7\u00e3o recomendada 1:1, ex: 1080x1080 px)",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "produtos": {
      "type": "array",
      "description": "Produtos/servi\u00e7os em promo\u00e7\u00e3o (fotografia do cadastro no momento da cria\u00e7\u00e3o) e itens personalizados criados na campanha",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "foto_url": {
            "type": "string"
          },
          "valor_original": {
            "type": "number"
          },
          "valor_promocional": {
            "type": "number"
          },
          "personalizado": {
            "type": "boolean",
            "default": false,
            "description": "Se verdadeiro, \u00e9 um item criado na campanha e n\u00e3o um produto do estoque"
          }
        }
      },
      "default": []
    },
    "lista_preco_id": {
      "type": "string",
      "description": "Lista de pre\u00e7os usada como refer\u00eancia de valor na campanha (vazio = pre\u00e7o de tabela do cadastro)"
    },
    "lista_preco_nome": {
      "type": "string",
      "description": "Nome da lista de pre\u00e7os de refer\u00eancia (cache para exibi\u00e7\u00e3o)"
    },
    "modo_selecao": {
      "type": "string",
      "enum": [
        "todos",
        "categorias",
        "especificos"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "especificos",
      "description": "Como os produtos foram escolhidos"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "grupos_ids": {
      "type": "array",
      "description": "Grupos de clientes que recebem a campanha",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "todos_clientes": {
      "type": "boolean",
      "default": false,
      "description": "Se verdadeiro, dispara para todos os clientes com telefone"
    },
    "filtros_clientes": {
      "type": "object",
      "description": "Filtros adicionais aplicados sobre os grupos/todos os clientes no disparo",
      "properties": {
        "codigo_de": {
          "type": "number",
          "description": "C\u00f3digo inicial do cliente (faixa)"
        },
        "codigo_ate": {
          "type": "number",
          "description": "C\u00f3digo final do cliente (faixa)"
        },
        "nome_iniciais": {
          "type": "string",
          "description": "Letras iniciais do nome do cliente separadas por v\u00edrgula (ex: A, B, C)"
        }
      }
    },
    "whatsapp_retorno": {
      "type": "string",
      "description": "N\u00famero do WhatsApp que recebe os interesses dos clientes"
    },
    "imagem_mensagem_url": {
      "type": "string",
      "description": "Imagem anexada no disparo da campanha"
    },
    "audio_url": {
      "type": "string",
      "description": "\u00c1udio anexado no disparo da campanha"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "\u00daltimo dia da promo\u00e7\u00e3o"
    },
    "ativa": {
      "type": "boolean",
      "default": true
    },
    "popup_ativo": {
      "type": "boolean",
      "default": true,
      "description": "Exibe os produtos em oferta em um pop-up para todos os usu\u00e1rios do sistema"
    },
    "vale_ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se verdadeiro, quem reservar produtos pela p\u00e1gina p\u00fablica recebe um vale desconto extra"
    },
    "vale_tipo": {
      "type": "string",
      "enum": [
        "percentual",
        "fixo"
      ],
      "enumColors": [
        "purple",
        "green"
      ],
      "default": "percentual",
      "description": "Tipo do vale desconto oferecido na reserva"
    },
    "vale_valor": {
      "type": "number",
      "default": 0,
      "description": "Valor do vale (percentual quando vale_tipo = percentual, em R$ quando fixo)"
    },
    "vale_validade_dias": {
      "type": "number",
      "default": 30,
      "description": "Quantidade de dias de validade do vale a partir da reserva"
    },
    "vale_motivo": {
      "type": "string",
      "description": "Motivo/aplica\u00e7\u00e3o do vale escrita pela empresa (ex: desconto para instala\u00e7\u00e3o do produto). Aparece para o cliente no vale."
    },
    "total_enviados": {
      "type": "number",
      "default": 0
    },
    "total_interesses": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}