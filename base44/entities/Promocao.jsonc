{
  "name": "Promocao",
  "type": "object",
  "properties": {
    "unidade_id": {
      "type": "string",
      "description": "ID da unidade a que esta promo\u00e7\u00e3o pertence"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da campanha promocional"
    },
    "texto": {
      "type": "string",
      "description": "Texto da promo\u00e7\u00e3o enviado no WhatsApp e exibido na p\u00e1gina p\u00fablica. Aceita {nome} para o nome do cliente."
    },
    "banner_url": {
      "type": "string",
      "description": "Banner de topo da p\u00e1gina p\u00fablica"
    },
    "artes": {
      "type": "array",
      "description": "Artes promocionais exibidas ao longo da p\u00e1gina p\u00fablica",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "produtos": {
      "type": "array",
      "description": "Produtos/servi\u00e7os em promo\u00e7\u00e3o (fotografia do cadastro no momento da cria\u00e7\u00e3o)",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "foto_url": {
            "type": "string"
          },
          "valor_original": {
            "type": "number"
          },
          "valor_promocional": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "modo_selecao": {
      "type": "string",
      "enum": [
        "todos",
        "categorias",
        "especificos"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "especificos",
      "description": "Como os produtos foram escolhidos"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "grupos_ids": {
      "type": "array",
      "description": "Grupos de clientes que recebem a campanha",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "todos_clientes": {
      "type": "boolean",
      "default": false,
      "description": "Se verdadeiro, dispara para todos os clientes com telefone"
    },
    "whatsapp_retorno": {
      "type": "string",
      "description": "N\u00famero do WhatsApp que recebe os interesses dos clientes"
    },
    "imagem_mensagem_url": {
      "type": "string",
      "description": "Imagem anexada no disparo da campanha"
    },
    "audio_url": {
      "type": "string",
      "description": "\u00c1udio anexado no disparo da campanha"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "\u00daltimo dia da promo\u00e7\u00e3o"
    },
    "ativa": {
      "type": "boolean",
      "default": true
    },
    "popup_ativo": {
      "type": "boolean",
      "default": true,
      "description": "Exibe os produtos em oferta em um pop-up para todos os usu\u00e1rios do sistema"
    },
    "total_enviados": {
      "type": "number",
      "default": 0
    },
    "total_interesses": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}