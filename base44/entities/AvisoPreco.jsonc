{
  "name": "AvisoPreco",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do an\u00fancio exibido no pop-up"
    },
    "origem": {
      "type": "string",
      "description": "Onde a altera\u00e7\u00e3o foi gerada (cadastro manual, nota de compra em PDF, NF-e XML)"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que gerou a altera\u00e7\u00e3o"
    },
    "itens": {
      "type": "array",
      "description": "Produtos com pre\u00e7o novo e o pre\u00e7o antigo quando existir",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "preco_antigo": {
            "type": "number"
          },
          "preco_novo": {
            "type": "number"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}