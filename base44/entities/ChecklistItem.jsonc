{
  "name": "ChecklistItem",
  "type": "object",
  "properties": {
    "item": {
      "type": "string",
      "description": "Nome do item do checklist"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria do item"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "obrigatorio": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 obrigat\u00f3rio preencher"
    },
    "nivel_orcamento": {
      "type": "string",
      "enum": [
        "urgencia",
        "servico_completo"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "urgencia",
      "description": "Em qual quadro do or\u00e7amento do cliente este item entra: 'urgencia' entra nos quadros Itens de Urg\u00eancia e Servi\u00e7o Completo; 'servico_completo' entra somente no quadro Servi\u00e7o Completo (os itens da queixa sempre entram no primeiro quadro)"
    },
    "produtos_padrao": {
      "type": "array",
      "description": "IDs dos produtos padr\u00e3o para este item",
      "items": {
        "type": "string"
      }
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o item est\u00e1 ativo"
    }
  },
  "required": [
    "item",
    "categoria",
    "ordem"
  ],
  "rls": {
    "read": {}
  }
}