{
  "name": "TarefaRotina",
  "type": "object",
  "properties": {
    "unidade_id": {
      "type": "string",
      "description": "ID da unidade"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da tarefa"
    },
    "funcao_id": {
      "type": "string",
      "description": "ID da fun\u00e7\u00e3o do funcion\u00e1rio respons\u00e1vel"
    },
    "funcao_nome": {
      "type": "string",
      "description": "Nome da fun\u00e7\u00e3o (cache)"
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Dias da semana (0=Dom, 1=Seg, 2=Ter, 3=Qua, 4=Qui, 5=Sex, 6=S\u00e1b)"
    },
    "links": {
      "type": "array",
      "description": "Links de ferramentas/planilhas para esta tarefa",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "ativa": {
      "type": "boolean",
      "default": true
    },
    "lembrete_ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se verdadeiro, o sistema exibe um popup de lembrete e envia notifica\u00e7\u00e3o push nos dias e hor\u00e1rio configurados"
    },
    "lembrete_mensagem": {
      "type": "string",
      "description": "Mensagem exibida no popup e na notifica\u00e7\u00e3o push"
    },
    "lembrete_horario": {
      "type": "string",
      "description": "Hor\u00e1rio em que o popup aparece e a notifica\u00e7\u00e3o \u00e9 enviada (HH:MM)"
    },
    "lembrete_tipo": {
      "type": "string",
      "enum": [
        "unico",
        "recorrente"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "unico",
      "description": "unico = aparece uma \u00fanica vez na data informada; recorrente = repete nos dias da semana selecionados"
    },
    "lembrete_data": {
      "type": "string",
      "format": "date",
      "description": "Data do lembrete pontual (YYYY-MM-DD)"
    },
    "lembrete_dias": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [],
      "description": "Dias da semana do lembrete recorrente (0=Dom..6=S\u00e1b)"
    },
    "lembrete_ultimo_envio": {
      "type": "string",
      "description": "Controle interno: identificador do \u00faltimo envio push realizado (AAAA-MM-DD HH:MM)"
    }
  },
  "required": [
    "titulo",
    "funcao_id",
    "dias_semana"
  ]
}