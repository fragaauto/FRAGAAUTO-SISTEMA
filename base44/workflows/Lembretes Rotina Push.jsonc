{
  "description": "Verifica a cada 5 minutos os lembretes de rotina configurados e envia notifica\u00e7\u00e3o push para os usu\u00e1rios",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lembretes_rotina_push",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enviar_lembretes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enviarLembretesRotinaPush"
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar lembretes push",
            "description": "Lembretes do hor\u00e1rio atual"
          }
        }
      }
    ]
  },
  "name": "Lembretes Rotina Push",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}